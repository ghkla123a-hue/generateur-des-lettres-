"""Génère : QR code, Lettre_Template_Publipostage.docx (champs de fusion Word),
Lettres_Fusionnees.docx (1 lettre personnalisée par contact) + lettres individuelles.
Avant d'exécuter : mettre le VRAI lien Google Forms dans FORM_URL et votre nom dans EXPEDITEUR."""
import copy, openpyxl
from docx import Document
from docx.shared import Pt, Cm, RGBColor
from docx.enum.text import WD_ALIGN_PARAGRAPH, WD_BREAK
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.oxml.ns import qn
from docx.oxml import OxmlElement
from PIL import Image
from reportlab.graphics.barcode.qrencoder import QRCode, QRErrorCorrectLevel

FORM_URL  = "https://docs.google.com/forms/d/e/1FAIpQLScJiY0DjxIAJJB4Yg4vMWJNVsRb6Lm57dmBTjEzjRHcoLx-aA/viewform?pli=1"
EXPEDITEUR = "[Prénom NOM]"                          # <-- à remplacer
CONTACTS_XLSX = "Modele_Simulation_Risques.xlsx"     # onglet Contacts (source de publipostage)
BLEU, ROUGE, GRIS = "1F3864", "C00000", "F2F2F2"

# ---------- QR code
def make_qr(url, path="qrcode_questionnaire.png", box=12, border=3):
    q = QRCode(8, QRErrorCorrectLevel.M)
    q.addData(url); q.make(); n = q.getModuleCount()
    img = Image.new("RGB", ((n + 2 * border) * box,) * 2, "white"); px = img.load()
    for r in range(n):
        for c in range(n):
            if q.isDark(r, c):
                for dy in range(box):
                    for dx in range(box): px[(c + border) * box + dx, (r + border) * box + dy] = (0x1F, 0x38, 0x64)
    img.save(path); return path

# ---------- helpers docx
def shade(cell, hexcol):
    tcPr = cell._tc.get_or_add_tcPr(); sh = OxmlElement("w:shd")
    sh.set(qn("w:val"), "clear"); sh.set(qn("w:color"), "auto"); sh.set(qn("w:fill"), hexcol); tcPr.append(sh)
def no_borders(table):
    tblPr = table._tbl.tblPr; b = OxmlElement("w:tblBorders")
    for e in ("top", "left", "bottom", "right", "insideH", "insideV"):
        x = OxmlElement(f"w:{e}"); x.set(qn("w:val"), "nil"); b.append(x)
    tblPr.append(b)
def run(p, text, size=10.5, bold=False, color=None, italic=False):
    r = p.add_run(text); r.font.name = "Arial"; r._element.rPr.rFonts.set(qn("w:eastAsia"), "Arial")
    r.font.size = Pt(size); r.bold = bold; r.italic = italic
    if color: r.font.color.rgb = RGBColor.from_string(color)
    return r
def _fc(p, typ):
    r = p.add_run(); f = OxmlElement("w:fldChar"); f.set(qn("w:fldCharType"), typ); r._r.append(f); return r
def _instr(p, text):
    r = p.add_run(); i = OxmlElement("w:instrText"); i.set(qn("xml:space"), "preserve"); i.text = text; r._r.append(i)
def merge_field(p, name, size=10.5, bold=False, color=None):
    _fc(p, "begin"); _instr(p, f" MERGEFIELD {name} \\* MERGEFORMAT "); _fc(p, "separate")
    run(p, f"«{name}»", size, bold, color); _fc(p, "end")
def cond_field(p, name, prefix, size=10.5, bold=False):
    """{ IF { MERGEFIELD name } <> "" "prefix{ MERGEFIELD name }" "" }"""
    _fc(p, "begin"); _instr(p, " IF "); 
    _fc(p, "begin"); _instr(p, f" MERGEFIELD {name} "); _fc(p, "separate"); run(p, f"«{name}»"); _fc(p, "end")
    _instr(p, f' <> "" "{prefix}')
    _fc(p, "begin"); _instr(p, f" MERGEFIELD {name} "); _fc(p, "separate"); run(p, f"«{name}»"); _fc(p, "end")
    _instr(p, '" "" '); _fc(p, "separate"); run(p, f"{prefix}«{name}»", size, bold); _fc(p, "end")
def val(p, template, name, rec, size=10.5, bold=False, color=None, prefix=""):
    """template=True -> champ de fusion ; sinon -> valeur du contact"""
    if template:
        if prefix: cond_field(p, name, prefix, size, bold)
        else: merge_field(p, name, size, bold, color)
    else:
        v = rec[name]
        if v or not prefix: run(p, (prefix + str(v)) if v else "", size, bold, color)
def spacing(p, before=0, after=4, line=1.1):
    p.paragraph_format.space_before = Pt(before); p.paragraph_format.space_after = Pt(after); p.paragraph_format.line_spacing = line

def build_letter(doc, rec, qr_path, template):
    # bandeau
    t = doc.add_table(rows=1, cols=1); t.alignment = WD_TABLE_ALIGNMENT.CENTER; no_borders(t)
    c = t.rows[0].cells[0]; shade(c, BLEU); p = c.paragraphs[0]; spacing(p, 6, 0)
    run(p, "INSTITUT SUPÉRIEUR DES ÉTUDES TECHNOLOGIQUES DE RADÈS", 13, True, "FFFFFF")
    p2 = c.add_paragraph(); spacing(p2, 0, 6); run(p2, "Enquête académique – Intégrité des examens et qualité des diplômés", 10, False, "FFFFFF", True)
    p = doc.add_paragraph(); spacing(p, 6, 2); p.alignment = WD_ALIGN_PARAGRAPH.RIGHT
    run(p, "Radès, le 16 octobre 2026", 10)
    # destinataire
    p = doc.add_paragraph(); spacing(p, 4, 0)
    val(p, template, "Qualification", rec, bold=True); run(p, " ", bold=True)
    val(p, template, "Prénom", rec, bold=True); run(p, " ", bold=True); val(p, template, "Nom", rec, bold=True)
    p = doc.add_paragraph(); spacing(p, 0, 0)
    run(p, "Rôle : ", 10, True); val(p, template, "Rôle", rec, 10)
    if template: cond_field(p, "Fonction", " – Fonction : ", 10)
    else: val(p, False, "Fonction", rec, 10, prefix=" – Fonction : ")
    p = doc.add_paragraph(); spacing(p, 0, 0); run(p, "Organisme : ", 10, True); val(p, template, "Organisme", rec, 10)
    p = doc.add_paragraph(); spacing(p, 0, 8); run(p, "Courriel : ", 10, True); val(p, template, "Email", rec, 10)
    p = doc.add_paragraph(); spacing(p, 0, 8)
    run(p, "Objet : ", 10.5, True, ROUGE); run(p, "Invitation à participer à un questionnaire sur les fraudes aux examens (≈ 3 minutes, 15 questions)", 10.5, True)
    # corps
    p = doc.add_paragraph(); spacing(p, 0, 5); run(p, "Bonjour ")
    val(p, template, "Qualification", rec); run(p, " "); val(p, template, "Nom", rec); run(p, ",")
    p = doc.add_paragraph(); spacing(p, 0, 5); p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    run(p, "Dans le cadre d'un projet académique d'analyse des risques à l'ISET Radès, nous étudions les causes des "
           "fraudes aux examens et leurs conséquences sur la qualité et les compétences des diplômés. Pour mesurer la "
           "probabilité et l'impact de chaque cause, nous avons besoin de l'avis de personnes qui vivent les évaluations au "
           "quotidien : en tant que ")
    val(p, template, "Rôle", rec, bold=True); run(p, ", votre point de vue est précieux.")
    p = doc.add_paragraph(); spacing(p, 0, 6); p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    run(p, "Vos réponses restent confidentielles : votre nom et votre e-mail, demandés en début de questionnaire, ne servent qu'au suivi de la participation "
           "et ne seront jamais diffusés ; les résultats ne seront utilisés que dans le cadre pédagogique, scientifique et académique de cette étude, sous forme de moyennes. "
           "La précision de vos réponses conditionne directement la fiabilité des résultats : répondez selon votre expérience réelle, "
           "il n'existe ni bonne ni mauvaise réponse.")
    # infographie
    t = doc.add_table(rows=2, cols=3); t.alignment = WD_TABLE_ALIGNMENT.CENTER; no_borders(t)
    data = [("10 jours", "pour répondre"), ("≈ 3 min", "15 questions courtes"), ("Confidentiel", "usage académique uniquement")]
    for i, (big, small) in enumerate(data):
        c = t.rows[0].cells[i]; shade(c, GRIS); p = c.paragraphs[0]; p.alignment = WD_ALIGN_PARAGRAPH.CENTER; spacing(p, 4, 0)
        run(p, big, 18, True, ROUGE if i == 0 else BLEU)
        c = t.rows[1].cells[i]; shade(c, GRIS); p = c.paragraphs[0]; p.alignment = WD_ALIGN_PARAGRAPH.CENTER; spacing(p, 0, 4)
        run(p, small, 9, False, "404040")
    # lien + QR
    p = doc.add_paragraph(); spacing(p, 4, 0)
    t = doc.add_table(rows=1, cols=2); no_borders(t); t.alignment = WD_TABLE_ALIGNMENT.CENTER
    a, b = t.rows[0].cells; a.width = Cm(11.5); b.width = Cm(4.5)
    p = a.paragraphs[0]; spacing(p, 6, 3); run(p, "Accéder au questionnaire :", 11, True, BLEU)
    p = a.add_paragraph(); spacing(p, 0, 3); run(p, "Cliquez sur le lien ou scannez le QR code.", 10)
    p = a.add_paragraph(); spacing(p, 0, 3)
    # lien hypertexte réel
    rid = doc.part.relate_to(FORM_URL, "http://schemas.openxmlformats.org/officeDocument/2006/relationships/hyperlink", is_external=True)
    h = OxmlElement("w:hyperlink"); h.set(qn("r:id"), rid)
    r = OxmlElement("w:r"); rp = OxmlElement("w:rPr")
    for tag, v in (("w:rFonts", "Arial"),):
        f = OxmlElement(tag); f.set(qn("w:ascii"), v); f.set(qn("w:hAnsi"), v); rp.append(f)
    col = OxmlElement("w:color"); col.set(qn("w:val"), "0563C1"); rp.append(col)
    u = OxmlElement("w:u"); u.set(qn("w:val"), "single"); rp.append(u)
    sz = OxmlElement("w:sz"); sz.set(qn("w:val"), "20"); rp.append(sz)
    r.append(rp); tx = OxmlElement("w:t"); tx.text = FORM_URL; r.append(tx); h.append(r); p._p.append(h)
    p = b.paragraphs[0]; p.alignment = WD_ALIGN_PARAGRAPH.CENTER; p.add_run().add_picture(qr_path, width=Cm(3.3))
    # remerciements
    p = doc.add_paragraph(); spacing(p, 8, 5); p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    run(p, "Nous vous remercions sincèrement du temps accordé à cette enquête : votre contribution aide à améliorer l'équité "
           "et la crédibilité des évaluations dans notre établissement.")
    p = doc.add_paragraph(); spacing(p, 2, 0); run(p, "Cordialement,")
    p = doc.add_paragraph(); spacing(p, 0, 0); run(p, EXPEDITEUR, 10.5, True)
    p = doc.add_paragraph(); spacing(p, 0, 0); run(p, "Étudiant(e) – ISET Radès | Projet d'analyse des risques – Activité 4", 9.5, False, "404040")

def new_doc():
    d = Document(); s = d.sections[0]
    s.page_width, s.page_height = Cm(21), Cm(29.7)
    s.left_margin = s.right_margin = Cm(2); s.top_margin = Cm(1.5); s.bottom_margin = Cm(1.2)
    d.styles["Normal"].font.name = "Arial"; d.styles["Normal"].font.size = Pt(10.5)
    return d

def contacts():
    ws = openpyxl.load_workbook(CONTACTS_XLSX)["Contacts"]
    rows = list(ws.iter_rows(values_only=True)); h = rows[0]
    return [dict(zip(h, r)) for r in rows[1:] if r[1]]

if __name__ == "__main__":
    qr = make_qr(FORM_URL)
    d = new_doc(); build_letter(d, None, qr, True); d.save("Lettre_Template_Publipostage.docx")
    cs = contacts(); d = new_doc()
    for i, rec in enumerate(cs):
        build_letter(d, rec, qr, False)
        if i < len(cs) - 1: d.add_paragraph().add_run().add_break(WD_BREAK.PAGE)
        di = new_doc(); build_letter(di, rec, qr, False)
        di.save(f"Lettre_{rec['Nom']}_{rec['Prénom'].replace(' ','_')}.docx")
    d.save("Lettres_Fusionnees.docx"); print(len(cs), "lettres générées")